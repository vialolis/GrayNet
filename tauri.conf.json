{
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devPath": "index.html",
    "distDir": "index.html",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "GrayNet",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.graynet.app",
      "icon": ["icons/icon.ico"],
      "category": "Utility",
      "shortDescription": "",
      "longDescription": "",
      "copyright": "",
      "deb": {
        "depends": []
      },
      "macOS": {
        "frameworks": [],
        "minimumSystemVersion": ""
      },
      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": null
      }
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "fullscreen": false,
        "resizable": false,
        "title": "GrayNet Launcher",
        "width": 800,
        "height": 600
      }
    ]
  }
}

{
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devPath": "index.html",
    "distDir": "index.html",
    "withGlobalTauri": true
  },
  "package": {
    "productName": "GrayNet",
    "version": "0.1.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "shell": {
        "all": false,
        "open": true
      },
      "path": {
        "all": true
      }
    },
    "bundle": {
      "active": true,
      "targets": "all",
      "identifier": "com.graynet.app",
      "icon": ["icons/icon.ico", "icons/icon.png"],
      "category": "Utility",
      "shortDescription": "I2P Network Launcher",
      "longDescription": "One-click launcher for connecting to the I2P network",

      "resources": [
        "bin/i2pd.exe",
        "config/i2pd.conf",
        "config/tunnels.conf",
        "config/addresses.csv",
        "extensions/noscript.xpi",
        "config/zones.txt"
      ],

      "windows": {
        "certificateThumbprint": null,
        "digestAlgorithm": "sha256",
        "timestampUrl": null,
        "wix": {
          "language": "en-US"
        },
        "nsis": {
          "installMode": "currentUser"
        }
      },
      "deb": {
        "depends": []
      },
      "macOS": {
        "frameworks": [],
        "minimumSystemVersion": "10.13"
      }
    },
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"
    },
    "systemTray": {
      "iconPath": "icons/icon.ico",
      "iconAsTemplate": false,
      "menuOnLeftClick": false
    },
    "windows": [
      {
        "fullscreen": false,
        "resizable": false,
        "title": "GrayNet",
        "width": 500,
        "height": 600,
        "center": true
      }
    ]
  }
}